# Personal config. Gitignored.

# Which model runs scoring and tailoring. Switchable from /settings.
#   claude-cli   Claude Pro/Max subscription, via the Claude Code CLI
#   antigravity  Gemini on a Google account, via the Antigravity CLI (agy)
#   api          needs ANTHROPIC_API_KEY and separate API credits
# Neither CLI backend needs an API key.
backend: antigravity
cli_model: sonnet
cli_timeout: 300

# How many jobs to score at once. Each call is its own process, so the waiting
# overlaps. Measured on `agy`: 10 at a time scored 10 of 10; 15 at a time
# scored only 8 of 15, wasting the rest. Lower it if calls start failing.
concurrency: 10

# Antigravity CLI. `agy models` lists the ids; effort is part of the id.
agy_model: gemini-3.8-flash-high
agy_timeout: 600

# Output language for tailoring: en | de.
# German needs a German master resume. By convention that is resume.de.json
# next to resume.json, or point at it explicitly:
#   resume_paths:
#     de: resume.de.json
language: en

min_score: 60

sources:
  # SmartRecruiters has the best European coverage of the free ATS feeds.
  # Slugs are from careers.smartrecruiters.com/<slug>.
  smartrecruiters:
  - ContinentalAG
  greenhouse: []
  lever: []
  ashby: []

  # --- Bundesagentur fuer Arbeit: the primary German source ------------
  # Germany's official register — the largest by a wide margin, free, no
  # registration. Links to the employer rather than to itself, and can
  # exclude staffing agencies at the source, which is most of the noise in
  # a German technical search.
  #
  # A description costs one extra request per job, so keep `queries` to a
  # handful of broad words and let the fit scorer do the judging.
  arbeitsagentur:
    where: "Chemnitz"
    umkreis: 100            # km
    max_days_old: 1
    max_pages: 2
    max_details: 150        # cap on description fetches per run
    exclude_staffing: true  # drops Zeitarbeit and private recruiters
    queries:
    - Softwareentwickler
    - Embedded
    - Testautomatisierung
    - Python
    - Automotive Software
    - Bildverarbeitung
    - Computer Vision
    - Machine Learning
    - Künstliche Intelligenz
  arbeitnow:
    max_pages: 2
    keywords: [software, engineer, entwickler, embedded, python, test, automotive, vision, machine learning, perception]
    location_contains: [germany, deutschland, chemnitz, dresden, leipzig, remote]

  # --- GermanTechJobs: small, all IT, usually states a salary -----------
  # Publishes no location, so a `locations:` filter would reject all of it.
  germantechjobs:
    keywords: [software, engineer, entwickler, embedded, python, test, automotive, vision, machine learning, perception]

  # Adzuna: kept as a backstop for employers the others miss.
  # Narrow queries on purpose — broad ones are where the noise came from.
  # Free key (1,000 calls/month): https://developer.adzuna.com/
  adzuna:
    app_id: 1ef81c4f
    app_key: e81218b6eba83762bf95ea17d4904e10
    country: de
    where: "Chemnitz"
    distance: 100           # km — this is the big one
    max_days_old: 7
    max_pages: 2
    queries:
       # Deliberately narrow. The broad single words ("test", "software")
       # are what filled the queue with Projektleiter Hochbau.
    - HiL
    - Bildverarbeitung
    - Embedded Software
    - Machine Learning
    - Computer Vision
filters:
  title_exclude:
  - senior
  - lead
  - principal
  - head of
  - manager
  - director
  - architekt
  - teamleiter
  max_age_days: 7

  remote_only: false
db_path: jobs.db
profile_path: profile.md
resume_path: resume.json
applicant_path: applicant.yaml
output_dir: applications

# Headshot for the resume header. Copied into each application folder next
# to resume.tex, so the folder compiles anywhere. jpg, png or pdf — anything
# else pdflatex cannot include. A portrait crop around 600x760 px is about
# right. Leave the file missing and the resume prints a placeholder box
# instead; set this to "" to leave no space for a photo at all.
photo_path: photo.jpg
