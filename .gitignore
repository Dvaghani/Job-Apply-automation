__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Local config and personal data — never commit these
config.yaml
# The settings page's own backup, rewritten on every save.
config.yaml.bak
profile.md
resume.json
# Per-language masters: resume.de.json and friends.
resume.*.json
applicant.yaml
# Headshot for the resume header.
photo.jpg
photo.jpeg
photo.png
applications/
/Job application

*.db
# SQLite's write-ahead log sits beside the database and is not matched
# by *.db.
*.db-shm
*.db-wal
*.sqlite3
.env

# Exported setups. These contain the config, credentials, resumes and
# the whole job history — everything above, in one file.
jobpipe-setup*.zip
*.jobpipe.zip

# Extension token — a local secret, not shared.
.jobpipe-token
resume.json.bak
WHERE-THIS-CAME-FROM.txt
profile.md.bak